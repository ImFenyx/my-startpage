# Copie para .env e ajuste conforme necessário.
# Nenhuma destas variáveis é obrigatória — o projeto roda sem .env.

# Porta do backend Elysia (padrão: 8787)
PORT=8787

# Caminho do banco SQLite (padrão: ./data/startpage.sqlite)
# DB_PATH=/caminho/para/startpage.sqlite

# Origens extras permitidas no CORS, separadas por vírgula.
# Use ao acessar a startpage de outra máquina na rede local.
# EXTRA_ORIGINS=http://192.168.1.10:5173

# O token do Todoist NÃO vai aqui: ele é configurado pela interface e
# fica apenas no localStorage do seu navegador.
